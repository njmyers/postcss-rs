{
  "name": "@postcss-rs/node-postcss",
  "version": "0.1.0",
  "description": "High-performance PostCSS-compatible parser powered by Rust",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "napi": {
    "name": "postcss",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "postcss",
    "css",
    "parser",
    "rust",
    "performance",
    "napi"
  ],
  "dependencies": {
    "@node-rs/helper": "^1.2.1",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^1.2.1",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "node test/basic.test.js"
  }
}