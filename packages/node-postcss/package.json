{
  "name": "@postcss-rs/node-postcss",
  "version": "0.1.0",
  "description": "High-performance PostCSS-compatible parser powered by Rust",
  "keywords": [
    "postcss",
    "css",
    "parser",
    "rust",
    "performance",
    "napi"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "pnpm run build:ts && napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:ts": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "napi pre-publish -t npm",
    "bench": "tsx benches/parse.bench.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "version": "napi version"
  },
  "dependencies": {
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@logux/eslint-config": "^53.5.1",
    "@napi-rs/cli": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.0.0",
    "benny": "^3.7.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "postcss-parser-tests": "workspace:^",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "napi": {
    "binaryName": "postcss",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-pc-windows-msvc"
    ]
  }
}
