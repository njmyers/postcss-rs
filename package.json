{
  "name": "@postcss-rs/root",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Nick Myers <nickmyers111@gmail.com>",
  "workspaces": [
    "packages/node",
    "tests"
  ],
  "scripts": {
    "postinstall": ". ./scripts/create-bom.sh",
    "test": "pnpm --recursive --sort run test",
    "build:debug": "pnpm --recursive --sort run build:debug",
    "build:release": "pnpm --recursive --sort run build:release",
    "lint:prettier": "prettier --check \"**/*.{ts,js,mjs,json,md}\" --ignore-path .gitignore"
  },
  "engines": {
    "node": ">=20.12",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6"
  }
}
